GROQ_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=
TAVILY_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
USER_AGENT=scholarlens

# ── Models ──
# Groq chat model (RAG, btw side channel, session names)
CHAT_MODEL=openai/gpt-oss-120b
# Gemini model used when Groq fails
FALLBACK_CHAT_MODEL=gemini-3.5-flash
# Groq model used as the deepeval judge
JUDGE_MODEL=openai/gpt-oss-20b
# Cohere embedding model and its vector size (changing it needs fresh chats)
EMBEDDING_MODEL=embed-english-v3.0
EMBEDDING_DIM=1024
